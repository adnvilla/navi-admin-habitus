# Copiar a .env y rellenar. .env está en .gitignore.

# --- Requerido ---
OPENAI_API_KEY=sk-...

# --- LLM / embeddings (OpenAI) ---
MODEL_NAME=gpt-4.1-mini
EMBEDDER_MODEL=text-embedding-3-small

# --- Graphiti ---
# Namespace del grafo. Cambiar por proyecto si se quiere memoria separada.
GRAPHITI_GROUP_ID=main
# Episodios en paralelo. OpenAI Tier 1: 1-2, Tier 2: 5-8, Tier 3: 10-15.
SEMAPHORE_LIMIT=10

# --- FalkorDB ---
FALKORDB_PASSWORD=
FALKORDB_DATABASE=default_db
# 1 = habilita UI web en :3000, 0 = deshabilita
BROWSER=1

# --- FalkorDB Browser (UI :3000) ---
# Requerido por el Browser para cifrar credenciales de sesión. 64 hex = 32 bytes.
# Generar: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Puertos host (cambiar si chocan) ---
MCP_PORT=8000
FALKORDB_UI_PORT=3000
FALKORDB_PORT=6379

# --- Imagen ---
# Tags: https://hub.docker.com/r/zepai/knowledge-graph-mcp/tags
GRAPHITI_IMAGE_TAG=1.1.0-graphiti-0.30.1
